# GEMINI_API_KEY: Required for Gemini AI API calls (today's fuel price live search, toll fee estimation, journey explanation).
# In AI Studio, this is automatically injected from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TOMTOM_API_KEY: Primary routing provider key (TomTom Routing API with live traffic ETA, route alternatives, avoid=tollRoads variant, and Map Display API raster tiles).
# Free signup at https://developer.tomtom.com/ (2,500 free requests/day).
# If absent or daily limit reached (429), NaviFlow automatically falls back to OSRM ("No live traffic").
TOMTOM_API_KEY=""

# OCM_API_KEY: Optional. Open Charge Map API key for India EV charging station registry.
# Free signup at https://openchargemap.org/site/develop/api
OCM_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
